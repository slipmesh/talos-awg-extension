version: v1alpha1
metadata:
  name: amneziawg
  version: "@VERSION@"
  author: seacat
  description: |
    AmneziaWG kernel module (DPI-obfuscated WireGuard fork) for the slipmesh cluster, plus the
    `ext-awg` extension service that configures mesh/road-warrior AmneziaWG interfaces from a
    static ExtensionServiceConfig - see docs/extension-services.md.
  compatibility:
    talos:
      version: ">= v1.10.0"
