# Single source of truth for everything this build pins. Sourced by the Makefile;
# override any of it on the command line (e.g. `make extension TARGET_ARCH=arm64`).

# --- Talos --------------------------------------------------------------------------
# Should match ../talos-kernel/versions.env's own TALOS_VERSION - used for the extension
# manifest's `compatibility.talos.version` field. No longer used to reconstruct the
# amneziawg-pkg tag (see KERNEL_RELEASE below); kept in sync with ../talos-kernel by hand,
# same discipline as AWG_REF.
TALOS_VERSION=v1.14.0

# The ../talos-kernel release tag (its own RELEASE_TAG at release time, see that repo's
# Makefile) that published the amneziawg-pkg image this build consumes - ../talos-kernel
# now tags its images by release, not by a TALOS_VERSION+AWG_REF reconstruction (mirroring
# ../bird), so this has to be pinned explicitly. Bump it by hand after a new talos-kernel
# release; TALOS_VERSION/AWG_REF above stay as informational cross-checks that the two
# repos' pins haven't silently drifted apart, and still feed EXT_VERSION.
# Must name a talos-kernel release built from the same AWG_REF below - otherwise this
# extension packages one module while its version string claims another.
KERNEL_RELEASE=v0.1.4+talos1.14.0

# siderolabs/extensions checkout used to package amneziawg-pkg (built in ../talos-kernel)
# into an actual Talos system extension via its own pkg.yaml/bldr pipeline - see
# docs/kernel-signing.md. Pinned for reproducibility, but not coupled to a specific Talos
# release the same way talos-kernel's UPSTREAM_PKGS_REF is - extensions only consumes an
# OCI image ref for the kernel package, not source-level kernel state. A release tag all
# the same: upstream tags one per Talos version, which reads as a version instead of a
# hash. Derived rather than repeated: the two must agree, and a second literal is a second
# thing to forget.
UPSTREAM_EXTENSIONS_REF=${TALOS_VERSION}

# --- the thing we actually package ---------------------------------------------
# amnezia-vpn/amneziawg-linux-kernel-module. Should match ../talos-kernel/versions.env's
# own AWG_REF - purely an informational cross-check now (see KERNEL_RELEASE above for how
# the actual amneziawg-pkg tag is found), but still folded into EXT_VERSION below. This
# repo doesn't build the module, so it has no need for AWG_SHA256/AWG_SHA512 (those live
# in talos-kernel, the only place that actually fetches the source).
#
# 3.1 adds two device attributes and moves nothing: WG_GENL_VERSION stays 3, so `awg`
# built against 3.0 sets neither and keeps working. See talos-kernel's own note.
AWG_REF=v3.1.20260828

# --- the daemon that ships inside the extension --------------------------------------
# slipmesh/talos-extensions release tag holding the daemon and its extension-services
# manifest. `make check-daemons` refuses to build unless the sibling checkout sits at it;
# DAEMONS_SHA (Makefile) only records what was used, it never constrained it.
DAEMONS_REF=v0.1.6

# --- where the artifacts go -------------------------------------------------------
# The extension image this repo publishes. PKGS_NS (Makefile) is where ../talos-kernel
# publishes amneziawg-pkg (its own versions.env's DOCKER_NS) - a separate namespace by
# convention, not something that needs to match IMAGE here.
IMAGE=ghcr.io/slipmesh/talos-awg-extension
