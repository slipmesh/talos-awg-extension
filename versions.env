# Single source of truth for everything this build pins. Sourced by the Makefile;
# override any of it on the command line (e.g. `make extension TARGET_ARCH=arm64`).

# --- Talos --------------------------------------------------------------------------
# Must match ../talos-kernel/versions.env's own TALOS_VERSION - this repo doesn't build
# the kernel itself, it consumes ../talos-kernel's published amneziawg-pkg image by tag,
# and that tag is derived from this same value. Also used for the extension manifest's
# `compatibility.talos.version` field.
TALOS_VERSION=v1.13.8

# siderolabs/extensions checkout used to package amneziawg-pkg (built in ../talos-kernel)
# into an actual Talos system extension via its own pkg.yaml/bldr pipeline - see
# docs/kernel-signing.md. Pinned for reproducibility, but not coupled to a specific Talos
# release the same way UPSTREAM_PKGS_REF (in ../talos-kernel) is - extensions only
# consumes an OCI image ref for the kernel package, not source-level kernel state, so any
# recent commit works. Bump freely; `make checkout-extensions` just needs it to resolve.
UPSTREAM_EXTENSIONS_REF=30067720457851d26682a0bcf50165efac3059c0

# --- the thing we actually package ---------------------------------------------
# amnezia-vpn/amneziawg-linux-kernel-module. Must match ../talos-kernel/versions.env's own
# AWG_REF - together with TALOS_VERSION above, this reconstructs the exact tag
# ../talos-kernel publishes amneziawg-pkg under. This repo doesn't build the module, so it
# has no need for AWG_SHA256/AWG_SHA512 (those live in ../talos-kernel, the only place
# that actually fetches the source).
AWG_REF=ce163101dbcddfb64631f5fea52252ea836372b5

# --- where the artifacts go -------------------------------------------------------
# The extension image this repo publishes. PKGS_NS (Makefile) is where ../talos-kernel
# publishes amneziawg-pkg (its own versions.env's DOCKER_NS) - a separate namespace by
# convention, not something that needs to match IMAGE here.
IMAGE=ghcr.io/slipmesh/talos-awg-extension
