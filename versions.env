# Single source of truth for everything this build pins. Sourced by the Makefile;
# override any of it on the command line (e.g. `make all TARGET_ARCH=arm64`).

# --- Talos ----------------------------------------------------------------------
# The version the nodes run. Everything else follows from it: the module is compiled
# against a specific kernel and carries its vermagic, so a mismatch here means a module
# that loads nowhere.
TALOS_VERSION=v1.13.7

# --- upstream siderolabs pkgs ---------------------------------------------------
# Source of the kernel config, signing certs and patch set, plus the pinned kernel
# version and the toolchain image revision. NOT a free choice - Talos states which pkgs
# it was built from:
#
#   curl https://raw.githubusercontent.com/siderolabs/talos/$TALOS_VERSION/pkg/machinery/gendata/data/pkgs
#
# For v1.13.7 that is "v1.13.0-49-g91fe0a0", i.e. commit 91fe0a0, whose Pkgfile pins
# linux_version 6.18.39 - which is what the cluster runs. `make check-pins` asserts it.
#
# (An earlier revision pinned b253464, inherited from the pre-split experimental tree.
# That builds kernel 6.18.40, one patch ahead of the nodes: the build would have
# succeeded and the module would have silently refused to load.)
UPSTREAM_PKGS_REF=91fe0a0dc065c93f0405eb60b4bbec19c7e96e12

# --- the thing we actually package ---------------------------------------------
# amnezia-vpn/amneziawg-linux-kernel-module. Regenerate the hash with `make hashes`
# after changing the ref.
AWG_REF=ae0924ca700520ca34c5bdbcfd05b2f683ea9353
AWG_SHA256=d13d452e358c894bb37cb8987b63904035552706062f6f488e32d644e4926ebe

# --- target -----------------------------------------------------------------------
# amd64 or arm64 - the architecture of the NODES, which need not be the architecture of
# the machine running this build. clang is a cross-compiler, so building amd64 from an
# aarch64 workstation is a normal native-speed cross build, not emulation. See README.
TARGET_ARCH=amd64

# --- where the artifacts go -------------------------------------------------------
# Only the INSTALLER is published: it is what `talosctl upgrade` makes the nodes pull,
# and what you roll back to. The extension image never leaves this machine - it is an
# intermediate artifact that `make installer` bakes in, so it is deliberately named
# localhost/... and has no push target. See README, "Why the extension is not published".
IMAGE=docker.io/ffaxl/talos
