# Single source of truth for everything this build pins. Sourced by the Makefile;
# override any of it on the command line (e.g. `make all TARGET_ARCH=arm64`).

# --- Talos --------------------------------------------------------------------------
# The version the nodes run - the module is compiled against its specific kernel and
# carries its vermagic.
TALOS_VERSION=v1.13.8

# --- upstream siderolabs pkgs ---------------------------------------------------------
# Source of the kernel config, signing certs, patch set and pinned kernel version. Not a
# free choice - derive it from the Talos version, see README "Pinning". `make check-pins`
# asserts it.
UPSTREAM_PKGS_REF=f677246a73ed1353a1e0ec9e92f0027b2f759978

# --- the thing we actually package ---------------------------------------------
# amnezia-vpn/amneziawg-linux-kernel-module. Regenerate the hash with `make hashes`
# after changing the ref.
AWG_REF=ce163101dbcddfb64631f5fea52252ea836372b5
AWG_SHA256=c493ab8ac6b4d1b8ccbd0c07a4a43011ccfc976a99ea5ef30cbd9175fb9364d2

# --- target -----------------------------------------------------------------------
# amd64 or arm64 - the NODES' architecture, not necessarily the build machine's. See
# README, "Cross-architecture". No default on purpose: pass it explicitly
# (`make all TARGET_ARCH=amd64`), or use `make release` to build both.

# --- where the artifacts go -------------------------------------------------------
# `talosctl upgrade` pulls the installer tag. `make installer` also publishes the
# extension image here first, since imager needs it as a registry reference - see
# README, "Publishing the extension".
IMAGE=docker.io/ffaxl/talos
