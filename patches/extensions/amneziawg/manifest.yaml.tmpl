version: v1alpha1
metadata:
  name: amneziawg
  version: "{{ .VERSION }}"
  author: slipmesh
  description: |
    AmneziaWG kernel module (DPI-obfuscated WireGuard fork), signed against and built together
    with the same Talos kernel package it ships alongside (see docs/kernel-signing.md in
    talos-awg-extension for why that matters), plus the `ext-awg` extension service that
    configures mesh/road-warrior AmneziaWG interfaces from a static ExtensionServiceConfig - see
    docs/extension-services.md.
  compatibility:
    talos:
      version: ">= v1.10.0"
